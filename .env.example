# Copy to .env (or export in your shell) to enable the AI-assisted summary.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The app tries these free models in order (src/minireport/llm.py):
#   1. google/gemma-4-31b-it:free             (main)
#   2. thinkingmachines/inkling-small:free
#   3. nvidia/nemotron-3-super-120b-a12b:free
#   4. inclusionai/ling-3.1-flash
#   5. poolside/laguna-s-2.1:free
#   6. liquid/lfm-2.5-2.6b:free               (last resort)
#
# If every model fails, the report still generates with the deterministic
# summary and the failure is shown in the review UI.
